# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/auth

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stock_auth_db
DB_SSL=false

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP Mail Configuration
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=harshilgohil2703@gmail.com
SMTP_PASS=YOUR_NEW_16_CHARACTER_APP_PASSWORD
SMTP_FROM_EMAIL=harshilgohil2703@gmail.com
SMTP_FROM_NAME="Stock Market App"

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_RESEND_LIMIT=3
